SRC_DIR=$PWD
BIN_DIR=$SRC_DIR/bin
TEST_DIR=$SRC_DIR/test
CPS_DIR=$TEST_DIR/compose

REG_DIR=$CPS_DIR/registry
REG_CERT_DIR=$REG_DIR/certs
# This must be relative to SRC_DIR path
REG_CERT=test/compose/registry/certs/registry.crt

# Image store of the test dockerd: false - the overlay2 graphdriver, true - the containerd image store
CONTAINERD_SNAPSHOTTER=false
# Set to 1 when the test dockerd includes the Foundries patches
DOCKERD_FIO_PATCH=
